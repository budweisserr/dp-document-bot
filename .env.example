# Telegram bot token from @BotFather (leave empty to run monitor-only)
BOT_TOKEN=

# Your numeric Telegram id (gets alerts when nobody subscribed)
ADMIN_ID=

# City the bot watches by default (see src/config.rs for keys)
DEFAULT_BRANCH=warszawa

# Site service id: 4 = biometric passport / ID-card (foreign branches)
SERVICE_ID=4

# Seconds between checks of one city (+/- INTERVAL_JITTER)
CHECK_INTERVAL=300
INTERVAL_JITTER=20

# Minimum gap between any two site requests (ms) — keep >= 3000
REQUEST_GAP_MS=5000

# Backoff after HTTP 429: first pause, doubling up to max
BLOCKED_SECS=600
BLOCKED_MAX_SECS=3600
# Short pause after a Cloudflare challenge (403) — used while rotating proxies
CHALLENGE_SECS=30

# Do not re-alert while slots stay open more often than this
ALERT_COOLDOWN=900

# Optional single proxy for site requests: http://user:pass@host:port or socks5://host:port
# (a fixed proxy disables PROXY_LIST)
PROXY=

# Or a proxy list: file path or URL, one scheme://host:port per line.
# Working entries are verified at startup and rotated on failures.
# e.g. https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/all.txt
PROXY_LIST=
# How often to reload and re-verify the list, hours (0 = only once)
PROXY_REFRESH_HOURS=6

# Open the booking page in the default browser when slots appear
OPEN_BROWSER=false

# Where subscribers.json / centers.json are stored
DATA_DIR=data

# Log level
RUST_LOG=info
